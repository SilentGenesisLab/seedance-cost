generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeedanceAccount {
  id          String           @id @default(cuid())
  name        String           @unique
  snapshots   CreditSnapshot[]
  anomalies   AnomalyEvent[]
  dailyUsages DailyUsage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model FetchRun {
  id           String           @id @default(cuid())
  sourceUrl    String
  status       FetchRunStatus   @default(RUNNING)
  totalCount   Int              @default(0)
  successCount Int              @default(0)
  anomalyCount Int              @default(0)
  errorMessage String?          @db.Text
  rawJson      String?          @db.Text
  startedAt    DateTime         @default(now())
  completedAt  DateTime?
  snapshots    CreditSnapshot[]
  anomalies    AnomalyEvent[]

  @@index([startedAt])
  @@index([status])
}

model CreditSnapshot {
  id             String          @id @default(cuid())
  fetchRunId     String
  fetchRun       FetchRun        @relation(fields: [fetchRunId], references: [id], onDelete: Cascade)
  accountId      String
  account        SeedanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vipCredit      Int
  giftCredit     Int
  purchaseCredit Int
  totalCredit    Int
  fetchedAt      DateTime
  rawStdout      String          @db.Text
  createdAt      DateTime        @default(now())

  @@index([accountId, fetchedAt])
  @@index([fetchRunId])
  @@index([fetchedAt])
}

model DailyUsage {
  id                 String          @id @default(cuid())
  accountId          String
  account            SeedanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountName        String
  date               DateTime        @db.Date
  usage              Int             @default(0)
  resetDetected      Boolean         @default(false)
  resetCount         Int             @default(0)
  resetDetectedAt    DateTime?
  previousSnapshotId String?
  currentSnapshotId  String?
  previousTotal      Int?
  currentTotal       Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([accountId, date])
  @@index([accountName, date])
  @@index([date])
  @@index([resetDetectedAt])
}

model AnomalyEvent {
  id          String           @id @default(cuid())
  fetchRunId  String
  fetchRun    FetchRun         @relation(fields: [fetchRunId], references: [id], onDelete: Cascade)
  accountId   String?
  account     SeedanceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountName String
  reason      String
  exitCode    Int?
  stdout      String           @db.Text
  stderr      String           @db.Text
  fetchedAt   DateTime
  createdAt   DateTime         @default(now())

  @@index([accountName, fetchedAt])
  @@index([fetchRunId])
  @@index([fetchedAt])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum FetchRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}
